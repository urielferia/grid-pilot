<Window x:Class="GridPilot.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GridPilot · Excel por voz y texto" Width="720" Height="860" MinWidth="600" MinHeight="650" Background="#F4F6FA" Closing="OnClosing">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="GridPilot" FontSize="28" FontWeight="SemiBold" Foreground="#213D61"/><TextBlock Text="Trabaja en un borrador visible. Revisa antes de exportar." Margin="0,6,0,18"/></StackPanel>
 <WrapPanel Grid.Row="1" x:Name="Controls"><Button Content="_Abrir libro" Click="Open"/><Button Content="Plantilla _demo" Click="Demo"/><Button Content="_Perfil…" Click="SelectProfile"/><Button Content="_Recuperar sesión" Click="Recover"/><Button Content="A_justes" Click="Configure"/></WrapPanel>
 <TextBlock Grid.Row="2" x:Name="Status" Text="Selecciona un archivo .xlsx para comenzar." TextWrapping="Wrap" Margin="0,8,0,12" FontWeight="SemiBold"/>
 <TabControl Grid.Row="3"><TabItem Header="Revisión"><TextBox x:Name="Review" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" Background="White"/></TabItem><TabItem Header="Estructura"><TextBox x:Name="Structure" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Lote local"><StackPanel Margin="12"><TextBlock Text="Modo determinista: pega una lista JSON de operaciones tipadas." TextWrapping="Wrap"/><TextBox x:Name="Batch" Height="250" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="[]"/><Button Content="Ejecutar lote en borrador" Click="ExecuteLocal" Margin="0,12,0,0"/></StackPanel></TabItem></TabControl>
 <StackPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock Text="Tu instrucción"/><TextBox x:Name="Instruction" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><WrapPanel Margin="0,8,0,0"><Button x:Name="Voice" Content="Mantén presionado para hablar" PreviewMouseLeftButtonDown="VoiceDown" PreviewMouseLeftButtonUp="VoiceUp" LostMouseCapture="VoiceLost"/><Button Content="Enviar" Click="Send"/><Button Content="Actualizar revisión" Click="Refresh"/></WrapPanel></StackPanel>
 <WrapPanel Grid.Row="5"><Button Content="Deshacer último lote" Click="Undo"/><Button Content="Aprobar y exportar…" Click="ApproveExport" Background="#213D61" Foreground="White"/><Button Content="Descartar sesión" Click="Discard"/></WrapPanel>
 </Grid>
</Window>
