<Window x:Class="GridPilot.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GridPilot · Excel by voice and text" Width="720" Height="860" MinWidth="600" MinHeight="650" Background="#F4F6FA" Closing="OnClosing">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
   <TextBlock x:Name="LanguageLabel" Text="Language:" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox x:Name="LanguageSelector" Width="110" SelectionChanged="ChangeLanguage" SelectedValuePath="Tag">
    <ComboBoxItem Content="English" Tag="en"/>
    <ComboBoxItem Content="Español" Tag="es"/>
   </ComboBox>
  </StackPanel>
  <StackPanel><TextBlock Text="GridPilot" FontSize="28" FontWeight="SemiBold" Foreground="#213D61"/><TextBlock x:Name="SubtitleText" Text="Work on a visible draft. Review before exporting." Margin="0,6,0,18"/></StackPanel>
 </DockPanel>
 <WrapPanel Grid.Row="1" x:Name="Controls"><Button x:Name="OpenBtn" Content="_Open workbook" Click="Open"/><Button x:Name="DemoBtn" Content="_Demo template" Click="Demo"/><Button x:Name="ProfileBtn" Content="_Profile…" Click="SelectProfile"/><Button x:Name="RecoverBtn" Content="_Recover session" Click="Recover"/><Button x:Name="SettingsBtn" Content="_Settings" Click="Configure"/></WrapPanel>
 <TextBlock Grid.Row="2" x:Name="Status" Text="Select an .xlsx file to begin." TextWrapping="Wrap" Margin="0,8,0,12" FontWeight="SemiBold"/>
 <TabControl Grid.Row="3"><TabItem x:Name="ReviewTab" Header="Review"><TextBox x:Name="Review" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" Background="White"/></TabItem><TabItem x:Name="StructureTab" Header="Structure"><TextBox x:Name="Structure" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem x:Name="BatchTab" Header="Local batch"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock x:Name="BatchHint" Text="Deterministic mode: paste a JSON list of typed operations." TextWrapping="Wrap"/><TextBox x:Name="Batch" Height="250" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="[]"/><Button x:Name="ExecuteBatchBtn" Content="Run batch on draft" Click="ExecuteLocal" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem></TabControl>
 <StackPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock x:Name="InstructionLabel" Text="Your instruction"/><TextBox x:Name="Instruction" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><WrapPanel Margin="0,8,0,0"><Button x:Name="Voice" Content="Speak" Click="ToggleVoice"/><Button x:Name="SendBtn" Content="Send" Click="Send"/><Button x:Name="RefreshBtn" Content="Refresh review" Click="Refresh"/></WrapPanel></StackPanel>
 <WrapPanel Grid.Row="5"><Button x:Name="UndoBtn" Content="Undo last batch" Click="Undo"/><Button x:Name="ApproveBtn" Content="Approve and export…" Click="ApproveExport" Background="#213D61" Foreground="White"/><Button x:Name="DiscardBtn" Content="Discard session" Click="Discard"/></WrapPanel>
 </Grid>
</Window>
